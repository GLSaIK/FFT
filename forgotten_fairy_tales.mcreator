      "subtitles.salt3": "",
      "item.forgotten_fairy_tales.lore_vase": "Lore Vase",
      "item.forgotten_fairy_tales.bream": "Bream",
      "item.forgotten_fairy_tales.strausingoegg": "Яйцо страусинго",
